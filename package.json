{
  "name": "whiteboard-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "pnpm db:migrate && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @whiteboard/web test:e2e",
    "db:generate": "pnpm --filter @whiteboard/shared db:generate",
    "db:migrate": "pnpm --filter @whiteboard/shared db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@whiteboard/config": "workspace:*",
    "eslint": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.3",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --flag v10_config_lookup_from_file --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  }
}
