# apps/web environment. Copy to .env for local development.
# Everything here is PUBLIC: it is compiled into the browser bundle. Never put secrets here.
# Validated by packages/shared/src/env/web.ts at build time and at startup.

# Base URL of apps/server (REST).
VITE_API_URL=http://localhost:4000

# Base URL of the real-time sync server (WebSocket, same service as the API).
VITE_WS_URL=ws://localhost:4000

# Supabase (sign-in only): Dashboard → Project Settings → API keys. Both values are public.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
