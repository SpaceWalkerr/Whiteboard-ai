# apps/server environment. Copy to .env for local development.
# Validated at boot by packages/shared/src/env/server.ts — the server refuses to start if a
# required value is missing or invalid.

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Supabase Postgres. Use a SEPARATE Supabase project for development (never production).
# Dashboard → Connect → "Session pooler" connection string (port 5432, works over IPv4).
# Replace [YOUR-PASSWORD] with the database password. Keep ?sslmode=require.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Postgres connections per instance. Supabase's session pooler allows ~15 per project on
# small computes: instances × DATABASE_POOL_MAX (+ migrations, tests) must stay below it.
# At most half of the pool is used for sync persistence writes.
DATABASE_POOL_MAX=10

# Redis. Optional outside production; required when NODE_ENV=production (Render Key
# Value). With REDIS_URL set, this instance shares rooms with the others (pub/sub) and a
# lease decides which instance persists each room. Leave empty for local development.
REDIS_URL=
# Redis for the multi-instance tests in `pnpm test` (not used by the server itself).
# Start one with: redis-server (see docs/scaling.md → Tools), or the scale stack's Redis.
TEST_REDIS_URL=redis://127.0.0.1:6379

# Names this instance in logs/Redis/leases (a random suffix is added per process).
# Defaults to Render's RENDER_INSTANCE_ID; optional.
INSTANCE_ID=
# Multi-instance only: persistence lease TTL (a dead instance's rooms are taken over within
# this time) and how often rooms re-check with other instances for missed updates.
SYNC_LEASE_TTL_MS=15000
SYNC_RESYNC_MS=15000

# Comma-separated browser origins allowed for CORS and WebSocket upgrades (no paths).
# 5173 = `pnpm dev` web app, 4173 = `vite preview` used by the Playwright smoke test.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional regex (anchored automatically) for this project's Vercel preview URLs, e.g.
# CORS_ALLOWED_ORIGIN_PATTERN=https://whiteboard-ai-[a-z0-9-]+-your-team\.vercel\.app
CORS_ALLOWED_ORIGIN_PATTERN=

# Supabase project URL (Dashboard → Project Settings → API). Access tokens are verified with
# this project's public signing keys (JWKS), fetched from <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret / service_role key: server-only (Storage for thumbnails). Required in production.
SUPABASE_SERVICE_ROLE_KEY=

# Signs 5-minute WebSocket room tickets. Generate with: openssl rand -hex 32
ROOM_TICKET_SECRET=
# Public URL of the web app (used in email links).
APP_URL=http://localhost:5173

# Email: "log" prints emails (with links) to this server's log — development only.
# "resend" sends them; required in production together with RESEND_API_KEY and EMAIL_FROM.
EMAIL_TRANSPORT=log
RESEND_API_KEY=
EMAIL_FROM=Whiteboard.ai <no-reply@your-domain.com>

# Bearer secret for internal cron endpoints (POST /internal/purge-trash, called daily by a
# Render Cron Job). Optional locally; required in production. openssl rand -hex 32
CRON_SECRET=

# Number of proxy hops to trust for the client IP (0 locally, 1 on Render).
TRUST_PROXY=0

# Sync server (WebSocket /rooms/:boardId).
# How long an empty room keeps its document in memory (ms).
SYNC_ROOM_GRACE_MS=30000
# Per-connection message rate limit (token bucket): sustained rate and burst size.
SYNC_RATE_LIMIT_PER_SEC=120
SYNC_RATE_LIMIT_BURST=300
# Per-connection byte budget: sustained bytes/second and burst (a reconnect sends the whole
# board in one message, so the burst must fit your largest board).
SYNC_BYTES_PER_SEC=1048576
SYNC_BYTES_BURST=16777216

# Persistence: max batching delay before updates are written to Postgres (ms), and how many
# updates to accumulate before compacting a board's log into a snapshot.
SYNC_FLUSH_MS=50
SNAPSHOT_EVERY_UPDATES=500

# Bearer token protecting GET /metrics (Prometheus). Leave empty locally; REQUIRED in
# production (generate with: openssl rand -hex 32).
METRICS_TOKEN=

# Hard deadline for graceful shutdown on SIGTERM. Must be below Render's shutdown window.
SHUTDOWN_TIMEOUT_MS=25000
