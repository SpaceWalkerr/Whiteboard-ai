{
  "name": "@whiteboard/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "load:seed": "tsx --env-file-if-exists=.env scripts/loadtest-seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@react-email/components": "1.0.12",
    "@whiteboard/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "5.12.5",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "lib0": "catalog:",
    "pino": "10.3.1",
    "postgres": "catalog:",
    "prom-client": "15.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.29.0",
    "ws": "8.21.3",
    "y-protocols": "catalog:",
    "yjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@whiteboard/config": "workspace:*",
    "eslint": "catalog:",
    "pino-pretty": "13.1.3",
    "tsup": "8.5.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
