{
  "name": "@whiteboard/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@whiteboard/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "5.12.5",
    "ioredis": "5.11.1",
    "pino": "10.3.1",
    "postgres": "catalog:",
    "ws": "8.21.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "8.18.1",
    "@whiteboard/config": "workspace:*",
    "eslint": "catalog:",
    "pino-pretty": "13.1.3",
    "tsup": "8.5.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
